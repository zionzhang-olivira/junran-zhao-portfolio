---
import "./pose-desk.css";
---
<section class="pose-desk" id="drawing" aria-labelledby="pose-title">
  <header class="pose-head">
    <strong id="pose-title">Fox pull animation</strong>
    <span class="pose-count">Drawing <strong data-count>17</strong> of 31</span>
  </header>
  <div class="pose-stage">
    <img data-ink src="/studies/fox/inks/f17.webp" width="768" height="432" alt="Drawing 17 from Junran Zhao’s fox pulling a rope." fetchpriority="high" />
    <video data-film controls playsinline preload="none" width="1280" height="720" aria-label="Fox pull, silent animation by Junran Zhao" hidden></video>
  </div>
  <div class="pose-console" data-tools hidden>
    <div class="pose-ruler-head"><label for="pose-range">Source drawing</label><span data-clock>1.19 s</span></div>
    <div class="pose-scrub" role="group" aria-label="Step through source drawings">
      <button type="button" data-step="-1" aria-label="Previous drawing">←</button>
      <div class="pose-track"><div class="pose-ticks" aria-hidden="true"><i></i></div><input id="pose-range" type="range" min="1" max="31" step="1" value="17" /></div>
      <button type="button" data-step="1" aria-label="Next drawing">→</button>
    </div>
  </div>
  <div class="pose-actions">
    <a class="pose-play" data-play href="/media/fox-pull.mp4"><span aria-hidden="true">▶</span> Play film</a>
    <button class="pose-play" type="button" data-return hidden>Return to drawings</button>
    <a class="pose-detail" data-detail href="/work/fox-motion-studies/?frame=17&amp;from=home&amp;study=1#original-film">Study this drawing <span aria-hidden="true">↗</span></a>
  </div>
  <p class="pose-message" role="status" data-status></p>
</section>
<script>
  import { mountPoseDesk } from "./pose-desk";
  const desk = document.querySelector<HTMLElement>(".pose-desk");
  if (desk) mountPoseDesk(desk);
</script>


<style>
.pose-desk{margin:0}.pose-head strong{font:400 clamp(23px,2.3vw,34px)/1.08 var(--serif);letter-spacing:-.025em}
.pose-count,.pose-ruler-head{color:var(--ink);font:500 .82rem/1.4 var(--body);font-variant-numeric:tabular-nums}
.pose-scrub{border-block-end:1px solid var(--plate-rule);padding-bottom:3px}.pose-scrub button{border:0;border-radius:0;color:var(--ink);background:transparent;font-size:24px;text-underline-offset:4px}
.pose-play,.pose-actions a.pose-play{color:var(--paper);background:var(--ink)}
.pose-actions a,.pose-actions button{font-family:var(--body)}.pose-detail{color:var(--accent);text-decoration:underline;text-underline-offset:4px}
.pose-scrub button:not(:disabled):hover{color:var(--accent);text-decoration:underline}.pose-play:hover,.pose-actions a.pose-play:hover{color:#fff;background:var(--accent);border-color:var(--accent)}
.pose-detail:hover{color:var(--ink);text-decoration-thickness:2px}
.pose-desk :focus-visible{outline:3px solid var(--accent);outline-offset:2px}
</style>



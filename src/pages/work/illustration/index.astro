---
import Site from "../../../layouts/Site.astro";
import Observation from "../visual-development/_Observation.astro";
import "../visual-development/_edition.css";
const turns=["Front","Side","Back"].map(a=>{const id=a.toLowerCase();return {id:"turn-"+id,label:a,image:"/studies/plates/brother-"+id+".webp",alt:"Brother, "+id+" view",pair:"/studies/plates/sister-"+id+".webp",pairAlt:"Sister, "+id+" view",caption:"Brother and sister · "+id+" view",href:"/work/character-studies/?angle="+id+"#turn-"+id};});
const hood=[{id:"hood-full",label:"Full painting",image:"/media/red-hood.webp",alt:"A hooded girl faces a wolf offering berries in the forest.",caption:"Complete painting",href:"/work/red-hood-and-wolf/#hood-full"},{id:"berries",label:"Berries",image:"/studies/plates/berries.webp",alt:"Berries in the space between the figures",caption:"Berries · detail of the painting",href:"/work/red-hood-and-wolf/#berries"}];
const phoenix=[{id:"pavilion-full",label:"Full drawing",image:"/studies/plates/pavilion-reading.webp",alt:"A phoenix over the stacked roofs of a pavilion.",caption:"Complete portrait-format drawing",href:"/work/pavilion-and-phoenix/#pavilion-full"},{id:"plumage",label:"Feathers",image:"/studies/plates/plumage.webp",alt:"Detail of the phoenix’s feathers.",caption:"Feathers · detail of the drawing",href:"/work/pavilion-and-phoenix/#plumage"},{id:"roof",label:"Eaves",image:"/studies/plates/roof.webp",alt:"The pavilion’s tiled roof in line drawing.",caption:"Eaves · detail of the drawing",href:"/work/pavilion-and-phoenix/#roof"}];
---
<Site title="Characters & Illustration" current="work" description="Examine Junran Zhao’s painted forest, sibling model sheet and pavilion drawing."><article class="edition"><header class="folio-intro"><h1>Characters &amp; illustration</h1><p>Follow a color through a painting, turn a character sheet, or look closely at a single feather.</p></header><Observation first layout="painting" title="Red Hood and the Wolf" prompt="Look between the figures. The berries repeat the red on the girl’s curls and the wolf’s muzzle." action="Study this painting" picks={hood}/><Observation title="Character sheets" prompt="Choose one of three views drawn on the siblings’ original color model sheet." action="Study this angle" picks={turns}/><Observation layout="vertical" title="Tengwang Pavilion and Phoenix" prompt="Trace the curve of a feather, then follow the straight beams of the roof." action="Study this drawing" picks={phoenix}/></article></Site>
